# DriftCourse server configuration. Copy to .env and edit.
# All settings are prefixed with DRIFT_.

# Bind address — LAN IP of the mini PC. 0.0.0.0 exposes to any interface.
DRIFT_HOST=192.168.1.7
DRIFT_PORT=8787

# llama-server binary (Windows .exe path on the mini PC)
DRIFT_LLAMA_SERVER_BIN=C:/tools/llama-b8851/llama-server.exe

# Model directory and default GGUFs
DRIFT_MODELS_DIR=./models
DRIFT_DEFAULT_MODEL=Qwen3-30B-A3B-Instruct-2507-Q4_K_M.gguf
# draft を空にすると spec decode 無効。Qwen3 と Qwen2.5-0.5B は tokenizer が近いが
# acceptance が低く (~35%) 、Radeon 780M では no-draft の方が速い (23 vs 3 tok/s)。
# 同系列の Qwen3-0.6B draft が出たら再評価する。
DRIFT_DEFAULT_DRAFT_MODEL=

# Inference parameters (validated in llm-exp-runbook / llm-exp-chatcache)
DRIFT_CTX_SIZE=8192
DRIFT_N_GPU_LAYERS=999
DRIFT_FLASH_ATTN=true
DRIFT_CACHE_TYPE_K=q8_0
DRIFT_CACHE_TYPE_V=q8_0
DRIFT_DRAFT_MAX=8

# Internal port that llama-server listens on (not exposed externally)
DRIFT_LLAMA_PORT=18080

# Bearer token file (auto-generated on first run)
DRIFT_TOKEN_FILE=.drift-token

# SQLite database path
DRIFT_DB_PATH=./drift.db
