<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DriftCourse" parent="android:Theme.Material.NoActionBar" />

    <!--
      起動時スプラッシュを最大サイズ表示にするテーマ。
      windowSplashScreenIconBackground を設定すると Android 12+ はアイコンを
      200dp に拡大する (未設定だと 160dp に収縮する安全ゾーン適用)。
      icon_preferred を指定して AVD/Pixel 系でもアイコンを優先表示。
    -->
    <style name="Theme.DriftCourse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFFFF</item>
        <item name="windowSplashScreenBackground">#FFFFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.DriftCourse</item>
    </style>
</resources>
