<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DriftCourse" parent="android:Theme.Material.NoActionBar">
        <!-- Compose が描画する前にチラ見えする背景。スプラッシュ画像そのものを置くので
             システムスプラッシュ終了 → windowBackground → Compose の遷移がシームレスになる。 -->
        <item name="android:windowBackground">@drawable/splash_window</item>
    </style>

    <!-- 起動時のシステムスプラッシュを見えなくする。背景色を画像の支配色に寄せ、
         アイコンを透明にすることで「スプラッシュが無い」アプリと同じ体感になる。 -->
    <style name="Theme.DriftCourse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#CFCFCF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/empty_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DriftCourse</item>
    </style>
</resources>
